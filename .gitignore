# runtime dir
node_modules
dist
dist-server
public_data

# temp file
*.log
*.tmp
*.temp
*.swp
*.swo
*~

# ide files
.DS_Store
.idea
.test
.codebuddy
.vscode
.env
.env.local
.env.*.local
# real secrets (keep the *.example templates tracked)
.dev.vars
.dev.vars.*
!.dev.vars.example
.wrangler
.reasonix

# build artifacts
*.tsbuildinfo
.rollup.cache

# local-only dev config (may contain real secrets; never commit)
wrangler.d1.toml
wrangler.local.jsonc

# OS files
Thumbs.db
desktop.ini

# test coverage
coverage/
.nyc_output/

# build output (keep in gitignore, should not commit)
pages/dist/
dist-server/
*.tsbuildinfo

# EdgeOne Makers Node 云函数：
#   cloud-functions/[[default]].js 是薄包装入口（入库），须被 EdgeOne 在构建前发现以注册 Node 云函数。
#   实际 bundle 由构建命令生成到 dist-server/edgeone-entry.js（dist-server/ 已在上方忽略）。
#   因此这里不再忽略整个 cloud-functions/ 目录，只忽略可能出现的临时产物。
# cloud-functions/ ← 已移除，入口文件需入库

# source maps (optional, can be removed)
*.map
*.js.map
*.css.map

# lock files (keep pnpm-lock.yaml only)
package-lock.json
yarn.lock

# misc
.cache/
.parcel-cache/
.turbo/

# cleanup scripts are tracked
!cleanup.bat
!cleanup.sh

# Security: Prevent sensitive files from being committed (Added: 2026-09-05)
*.key
*.pem
*.p12
*.pfx
*.cer
*.crt
**/.env
pages/.env
.env.production
.env.development
*.secret

# Security audit reports (contain sensitive information)
docs/3-Audit-Reports/
docs/*AUDIT*.md
docs/*SECURITY*.md
docs/TASK-COMPLETION-REPORT.md
# Local design/PR/review notes (kept on disk, not tracked)
docs/storage-architecture.md
docs/PR-config-unification.md
docs/code-review-*.md
wrangler.d1.jsonc
.wrangler-dryrun/
.tmp-dryrun/
